# Staging Environment Variables
# 
# ⚠️  CRITICAL: Upload to FRONTEND bucket path, NOT backend bucket!
# 
# CORRECT location: s3://chattapplication1-env-files/frontend/staging/.env
# 
# ❌ WRONG: Do NOT upload to s3://chattapplication1-env-files/staging/.env (backend path!)
# ❌ WRONG: Do NOT upload to s3://chattyapp-env-files/... (old/incorrect bucket name)
# 
# The backend uses: s3://chattapplication1-env-files/staging/.env.staging (different file!)
# The frontend uses: s3://chattapplication1-env-files/frontend/staging/.env (this file!)
# 
# IMPORTANT: Replace placeholder values with your actual credentials before uploading to S3

# Environment identifier - MUST be 'staging' for staging environment
# This tells the app to connect to: https://api.staging.chatappserver.space
VITE_APP_ENVIRONMENT=staging

# API Endpoint (base URL only - /api/v1 will be appended automatically)
# Your API is at: https://api.staging.chatappserver.space/api/v1
# But set only the base: https://api.staging.chatappserver.space
VITE_BASE_ENDPOINT=https://api.staging.chatappserver.space

# Cloudinary Configuration (REQUIRED for image/video uploads)
# Get this from your Cloudinary dashboard: https://cloudinary.com/console
# Format: your-cloud-name (e.g., "myapp-cloud")
VITE_CLOUD_NAME=your-cloudinary-cloud-name

# Giphy API Key (OPTIONAL - only needed if using Giphy GIF search feature)
# Get this from: https://developers.giphy.com/dashboard/
# Create an app and copy the API key
# VITE_GIPHY_API_KEY=your-giphy-api-key
